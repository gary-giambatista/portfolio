---
/**
 * Every page: head, fonts, theme (and, on bilingual pages, language) set before first paint.
 */
import { Font } from "astro:assets";
import "~/styles/fonts-cjk.css";
import "~/styles/tokens.css";
import "~/styles/base.css";

interface Props {
  title: string;
  description: string;
  /** The page offers EN/日本語; restore the visitor's language before paint. */
  bilingual?: boolean;
  ogImage?: string;
}
const { title, description, bilingual = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="theme-color" content="#F3F5F4" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0E131C" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="twitter:card" content="summary">
  <script is:inline define:vars={{ bilingual }}>
    // Restore theme (and language) before first paint so nothing flashes.
    var root = document.documentElement, store = {};
    try { store.theme = localStorage.getItem("theme"); store.lang = localStorage.getItem("lang"); } catch (_) {}
    if (store.theme === "light" || store.theme === "dark") root.dataset.theme = store.theme;
    if (bilingual) root.lang = store.lang || ((navigator.language || "").toLowerCase().startsWith("ja") ? "ja" : "en");
  </script>
  <Font cssVariable="--ff-mincho" preload={[{ weight: 800, subset: "latin" }]} />
  <Font cssVariable="--ff-plex-sans" preload={[{ weight: 400, subset: "latin" }]} />
  <Font cssVariable="--ff-plex-mono" preload={[{ weight: 400, subset: "latin" }]} />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>
