---
import { Image } from "astro:assets";
import Base from "~/layouts/Base.astro";
import SubNav from "~/components/SubNav.astro";
import IconSprite from "~/components/IconSprite.astro";
import PatternDyes from "~/components/PatternDyes.astro";
import Footer from "~/components/Footer.astro";
import portrait from "~/assets/img/gary-harbor.webp";
import { EMAIL, RESUME, SOCIAL } from "~/config/links";
import "~/styles/subnav.css";
import "~/styles/about.css";

/** The toolbox: [name, icon]. Icons are logos from simple-icons, or c-* glyphs for things without one. */
const TOOLBOX: { title: string; tools: [string, string][] }[] = [
  { title: "Front end", tools: [["TypeScript", "typescript"], ["JavaScript", "javascript"], ["React", "react"], ["Next.js", "nextdotjs"], ["Vue.js", "vuedotjs"], ["React Native", "react"], ["CSS", "css"], ["Tailwind", "tailwindcss"], ["HTML", "html5"], ["UI/UX", "c-layout"]] },
  { title: "Back end", tools: [["Node.js", "nodedotjs"], ["Express", "express"], ["PHP", "php"], ["Python", "python"], ["Liquid", "c-drop"], ["SQL", "c-db"], ["Convex", "convex"]] },
  { title: "AI and workflow", tools: [["Claude Code", "claude"], ["Codex", "c-codex"], ["Cursor", "cursor"], ["AI agent workflows", "c-agents"], ["Git", "git"], ["Google Cloud", "googlecloud"], ["Shopify", "shopify"], ["E-commerce", "c-cart"]] },
];
import "~/styles/ink-cards.css";
---
<Base title="About Gary Giambatista" description="I'm a software engineer in Hoboken, New Jersey, focused on making end to end experiences that people love. I care about the people on the other side of the screen, and I love turning hard problems into things that feel simple.">
<IconSprite slugs={TOOLBOX.flatMap(g => g.tools.map(t => t[1]))} />
<PatternDyes />
<SubNav current="about" ink />
<main>
  <section class="hero ink-card mon-card hero-cloth">
    <canvas class="sg" aria-hidden="true"></canvas>
    <div class="wrap">
      <div>
        <div class="eyebrow">About</div>
        <h1><span class="title-ink">Hi,&nbsp;I'm Gary.<canvas class="ink" data-ink="stroke-swash" data-seed="11" data-color="--indigo" data-dur="700" data-delay="700" data-start="visible" aria-hidden="true"></canvas></span></h1>
        <p class="dek">I'm a software engineer in Hoboken, New Jersey, focused on making end to end experiences that people love. I care about <b>the people on the other side of the screen</b>, and I love turning hard problems into things that feel simple.</p>
      </div>
      <figure class="portrait" tabindex="0" data-tip="New York Harbor" data-tip-sub="A short ferry ride from home in Hoboken">
        <canvas class="ink" data-ink="stroke-enso" data-seed="31" data-color="--brush" data-dur="1300" data-delay="150" data-start="visible" aria-hidden="true"></canvas>
        <Image src={portrait} alt="Gary on a boat in New York Harbor, with the Statue of Liberty behind him" widths={[180, 250, 360, 500]} sizes="(max-width: 820px) 112px, 250px" loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section>
    <div class="wrap col">
      <div class="eyebrow">The short version</div>
      <h2>I came to engineering the long way around.</h2>
      <p class="lead">I started in marketing, designing campaigns, ad funnels and websites for real estate listings and clients across the US. Then I moved to Japan and spent three years teaching English to more than 620 students, from one-year-olds to adults. In 2022 I came home to New Jersey, taught myself to code, and within a year I was solving real merchant problems at Rebuy Engine.</p>
      <p>At Rebuy I grew from Support Engineer to Software Engineer 1 in just over three years, across four roles. I launched more than 200 custom storefronts, helped scale Bundle Builder to $6M a month in merchant revenue, and led the greenfield Selectable Gift with Purchase widget from its admin panel all the way down to the database. Along the way I mentored teammates, helped interview new engineers, and became a go-to person for the widgets and cart that serve more than 8,400 Shopify merchants.</p>
      <p>Today I'm building <a href="/#kanji-kaku">Kanji Kaku</a>, an iOS and Android app for learning to write Japanese kanji. I design the system and direct AI coding agents to build it, backed by more than 240 automated tests. The tools keep changing. My job stays the same: understand the problem, own it, and ship something reliable.</p>
    </div>
  </section>

  <div class="wrap"><div class="sea-divider" id="seaDivider" aria-hidden="true"><div class="wave"><canvas class="wave-wash"></canvas><canvas class="wave-ink"></canvas></div></div></div>

  <section>
    <div class="wrap">
      <div class="col" style="max-width:none">
        <div class="eyebrow">How I work</div>
        <h2>Four habits I bring to every team.</h2>
      </div>
      <div class="principles">
        <article class="pr ink-card mon-card" data-mon="marketing"><canvas class="sg" aria-hidden="true"></canvas><div class="kj" lang="ja">人<small>HITO · PEOPLE</small></div><h3>Start with the people</h3><p>Every project starts with one question: what purpose does this serve? Understanding the person behind the problem is how I avoid building the wrong thing well.</p></article>
        <article class="pr ink-card mon-card" data-mon="work"><canvas class="sg" aria-hidden="true"></canvas><div class="kj" lang="ja">責任<small>SEKININ · OWNERSHIP</small></div><h3>Own the whole problem</h3><p>From a support ticket to a brand-new product, I treat the problem as mine until it's solved. Three years of triaging merchant issues taught me to follow a bug all the way to its root.</p></article>
        <article class="pr ink-card mon-card" data-mon="project"><canvas class="sg" aria-hidden="true"></canvas><div class="kj" lang="ja">設計<small>SEKKEI · DESIGN</small></div><h3>Design the system</h3><p>As AI changed how software gets written, my work shifted toward architecture: shaping the data, the boundaries and the tests, then directing agents to build inside them.</p></article>
        <article class="pr ink-card mon-card" data-mon="teaching"><canvas class="sg" aria-hidden="true"></canvas><div class="kj" lang="ja">丁寧<small>TEINEI · CARE</small></div><h3>Sweat the details</h3><p>Teaching kindergarten in a second language taught me patience and clarity. I bring the same care to interfaces: every state, every edge case, accessibility, and motion that helps instead of distracts.</p></article>
      </div>
    </div>
  </section>

  <section class="quote">
    <div class="wrap">
      <canvas class="ink" data-ink="quiet-enso" data-seed="23" data-color="--wash" data-dur="1500" data-delay="100" data-start="visible" aria-hidden="true"></canvas>
      <blockquote>“What purpose does this serve?”</blockquote>
      <div class="src">The question I ask before writing any code</div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">The path here</div>
      <h2>Each chapter taught me something I still use.</h2>
      <div class="path">
        <canvas class="ink" data-ink="stroke-path" data-seed="5" data-color="--brush" data-dur="1800" data-delay="150" data-start="visible" aria-hidden="true"></canvas>
        <ol class="stations">
          <li class="st" data-mon="marketing"><span class="dot" aria-hidden="true"></span><span class="yr">2016</span><h3>Marketing</h3><p>How products get sold, and who they're sold to. I still think about the funnel when I build a UI.</p></li>
          <li class="st" data-mon="teaching"><span class="dot" aria-hidden="true"></span><span class="yr">2019</span><h3>Teaching in Japan</h3><p>How to explain anything to anyone, in a second language, to an audience of 1 to 55-year-olds.</p></li>
          <li class="st" data-mon="learning"><span class="dot" aria-hidden="true"></span><span class="yr">2022</span><h3>Teaching myself to code</h3><p>HTML to Next.js on my own, and the first version of this site.</p></li>
          <li class="st" data-mon="work"><span class="dot" aria-hidden="true"></span><span class="yr">2023</span><h3>Rebuy Engine</h3><p>Four roles in three years, from answering tickets to leading a new product.</p></li>
          <li class="st now" data-mon="project"><span class="dot" aria-hidden="true"></span><span class="yr">Now</span><h3>Kanji Kaku</h3><p>Everything at once: product, design, architecture and teaching, in one app.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">By the numbers</div>
      <h2>A few things I'm proud of.</h2>
      <div class="numbers">
        <div class="num ink-card"><canvas class="sg" aria-hidden="true"></canvas><b>4 roles</b><span>in three years at Rebuy, Support Engineer to Software Engineer 1</span></div>
        <div class="num ink-card"><canvas class="sg" aria-hidden="true"></canvas><b>$6M</b><span>a month in merchant revenue through Bundle Builder, which I co-developed</span></div>
        <div class="num ink-card"><canvas class="sg" aria-hidden="true"></canvas><b>8,400+</b><span>Shopify merchants served by the widgets and cart I worked on</span></div>
        <div class="num ink-card"><canvas class="sg" aria-hidden="true"></canvas><b>200+</b><span>custom storefront launches as a Launch Engineer</span></div>
        <div class="num ink-card"><canvas class="sg" aria-hidden="true"></canvas><b>95%</b><span>customer satisfaction across 300+ support tickets</span></div>
        <div class="num ink-card"><canvas class="sg" aria-hidden="true"></canvas><b>620+</b><span>students taught in Japan, ages 1 to 55</span></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Toolbox</div>
      <h2>What I build with.</h2>
      <div class="tools">
        {TOOLBOX.map(({ title, tools }) => (
          <div><h3>{title}</h3><div class="chips">{tools.map(([name, icon]) => <span class="chip"><svg class="ico" aria-hidden="true"><use href={`#i-${icon}`} /></svg>{name}</span>)}</div></div>
        ))}
      </div>
      <div class="langs"><span><b>English</b> · native</span><span><b>日本語</b> · learned while living in Japan for three years</span></div>
    </div>
  </section>

  <div class="wrap">
    <section class="cta ink-card quiet" aria-labelledby="ctaTitle">
      <canvas class="sg" aria-hidden="true"></canvas>
      <canvas class="ink" data-ink="stroke-enso" data-seed="9" data-color="--wash" data-dur="1300" data-delay="150" data-start="visible" aria-hidden="true"></canvas>
      <span class="status"><i></i>Open to software engineering roles</span>
      <h2 id="ctaTitle">Let's build something people enjoy using.</h2>
      <p>I'm looking for a team that cares about its users as much as its code. Front end, full stack or mobile, I'd love to hear what you're working on.</p>
      <div class="actions">
        <button class="btn primary" type="button" id="copyEmail"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></svg><span class="email">{EMAIL}</span></button>
        <a class="btn" href={RESUME} target="_blank" rel="noopener">Resume (PDF) ↗</a>
        <a class="btn" href={SOCIAL.linkedin.href} target="_blank" rel="noopener">LinkedIn ↗</a>
        <span class="copied" id="copied" aria-live="polite"></span>
      </div>
    </section>
  </div>
</main>
<Footer />
</Base>

<script>
  import { initPopover } from "~/lib/popover";
  import { initThemeButton } from "~/lib/theme";
  import { initInk } from "~/lib/ink/canvas";
  import { initCopyEmail } from "~/lib/copy-email";
  import { initSeaDivider } from "~/lib/about-wave";
  import { initInkCards } from "~/lib/ink-cards";
  import { monPainter, pathBrocadePainter } from "~/lib/mon-cards";

  initPopover({ top: 66 });
  initThemeButton();
  initInk();
  initCopyEmail(document.getElementById("copyEmail"), document.getElementById("copied"));

  // Each chapter's dot takes its pattern as the brush line reaches it (see .stations in about.css).
  const stations = document.querySelector(".stations")!;
  new IntersectionObserver((es, io) => { if (es[0].isIntersecting) { stations.classList.add("go"); io.disconnect(); } }, { threshold: .25 }).observe(stations);

  initSeaDivider(document.getElementById("seaDivider"));
  initInkCards(document.querySelectorAll(".ink-card:not(.mon-card)"));
  initInkCards(document.querySelectorAll(".mon-card:not(.hero-cloth)"), monPainter);
  initInkCards(document.querySelectorAll(".hero-cloth"), pathBrocadePainter);
</script>
