---
/**
 * SVG symbols defined once and reused: skill logos (generated from simple-icons at build time),
 * a few custom glyphs for skills without a brand logo, and the plane.
 */
import * as si from "simple-icons";
import { SKILL_ICONS } from "~/content/timeline";

const bySlug = new Map(Object.values(si).filter((x): x is si.SimpleIcon => !!x && typeof x === "object" && "slug" in x).map(x => [x.slug, x]));
const CUSTOM: Record<string, string> = {
  "c-spark": '<path fill="currentColor" d="M12 2.5l2.2 6.6 6.8 2.4-6.8 2.4L12 20.5l-2.2-6.6L3 11.5l6.8-2.4z"/>',
  "c-cycle": '<path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="M20 12a8 8 0 1 1-2.3-5.7M20 3.5V8h-4.5"/>',
  "c-brush": '<path fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" d="M14.5 4.5l5 5L10 19l-6 1.5L5.5 14.5z"/>',
  "c-drop": '<path fill="currentColor" d="M12 2.5c4.4 5.3 6.6 9 6.6 11.9a6.6 6.6 0 0 1-13.2 0C5.4 11.5 7.6 7.8 12 2.5z"/>',
  "c-layout": '<g fill="none" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17M10 9.5v10"/></g>',
  "c-db": '<g fill="none" stroke="currentColor" stroke-width="2.1"><ellipse cx="12" cy="5.5" rx="7.5" ry="3"/><path d="M4.5 5.5v13c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-13M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/></g>',
  "c-agents": '<g fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><circle cx="12" cy="5.5" r="2.8"/><circle cx="5.5" cy="18" r="2.8"/><circle cx="18.5" cy="18" r="2.8"/><path d="M10.6 8l-3.8 7.5M13.4 8l3.8 7.5M8.3 18h7.4"/></g>',
  "c-cart": '<g fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5h2.6l2.3 11h10l2-8H6.5"/><circle cx="9.5" cy="19.5" r="1.3"/><circle cx="17" cy="19.5" r="1.3"/></g>',
  "c-codex": '<path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z"/>', // from lobehub.com/icons/codex
  "c-bug": '<g fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round"><path d="M8 9.5h8v5a4 4 0 0 1-8 0z"/><path d="M9.5 6.5l1 2.5M14.5 6.5l-1 2.5M4.5 12.5H8M16 12.5h3.5M5 18.5l3-1.5M19 18.5l-3-1.5"/></g>',
};
interface Props { /** Which icons to define; defaults to the timeline's skills. */ slugs?: string[] }
const slugs = [...new Set(Astro.props.slugs ?? Object.values(SKILL_ICONS))];
const symbols = slugs.map(slug => {
  const body = CUSTOM[slug] ?? (bySlug.get(slug) ? `<path fill="currentColor" d="${bySlug.get(slug)!.path}"/>` : null);
  if (!body) throw new Error(`No icon for ${slug}`);
  return `<symbol id="i-${slug}" viewBox="0 0 24 24">${body}</symbol>`;
}).join("");
const plane = '<symbol id="i-plane" viewBox="-26 -22 52 44"><path d="M1-3.2-7.5-20H-3L10.5-3.2ZM1 3.2-7.5 20H-3L10.5 3.2ZM-15.5-3.2-20.5-10.5H-17.5L-11.5-3.2ZM-15.5 3.2-20.5 10.5H-17.5L-11.5 3.2ZM-4.6-12.6h5.4v2.8h-5.4ZM-4.6 9.8h5.4v2.8h-5.4Z"/><path d="M-22 0C-22-2.6-18.5-3.4-12-3.4H13C19.5-3.4 24-1.8 25.5 0 24 1.8 19.5 3.4 13 3.4H-12C-18.5 3.4-22 2.6-22 0Z"/><path d="M15 -1.6h4" fill="none"/></symbol>';
---
<svg width="0" height="0" style="position:absolute" aria-hidden="true" set:html={symbols + plane}></svg>
