---
/**
 * The timeline's textures, generated at build time and dyed in each theme's indigo: one traditional pattern per
 * entry kind (MON in lib/patterns.ts). Emitted as CSS variables plus one rule per pattern for the badge cap, the
 * active header's wash and the ruler's readout (both drawn at twice the tile size), so the page ships no pattern code.
 */
import { DYES, MON, tileSize, url } from "~/lib/patterns";

const { light, dark } = DYES;

let lightVars = "", darkVars = "", useDark = "", rules = "";
for (const [name, draw] of Object.entries(MON)) {
  const tile = draw(light), [w, h] = tileSize(tile);
  lightVars += `--mon-${name}: ${url(tile)}; `;
  darkVars += `--mon-${name}-d: ${url(draw(dark))}; `;
  useDark += `--mon-${name}: var(--mon-${name}-d); `;
  rules += `[data-mon="${name}"] .kind .mon::before, .st[data-mon="${name}"] .dot::before { background-image: var(--mon-${name}); }
[data-mon="${name}"] .entry-head::before, .readout-dye[data-mon="${name}"] { background-image: var(--mon-${name}); background-size: ${w * 2}px ${h * 2}px; }
`;
}
const css = `:root { ${lightVars}${darkVars}}
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { ${useDark}} }
:root[data-theme="dark"] { ${useDark}}
${rules}`;
---
<style is:inline set:html={css}></style>
