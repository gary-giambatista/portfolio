---
/**
 * Selectable Gift with Purchase demo, rendered in its first state so the page never shifts when the script
 * starts. src/lib/widgets/gift-with-purchase.ts then updates only what changes.
 */
import { art, CART_LINES, GIFTS, GOAL1, GOAL2, ICO_CART, money } from "~/lib/widgets/catalog";

const subtotal = CART_LINES.reduce((a, l) => a + l.price * l.qty, 0);
const LOCK = '<svg viewBox="0 0 10 10"><rect x="2" y="4.5" width="6" height="4.5" rx="1"/><path d="M3.3 4.5V3.2a1.7 1.7 0 0 1 3.4 0v1.3"/></svg>';
---
<div class="rw" id="rw-gwp">
  <div class="rw-top"><span>Demo store · Selectable gift with purchase</span><span class="rw-cart" set:html={ICO_CART}></span></div>
  <h3 class="rw-title">Your cart</h3>
  <ul class="rw-lines">{CART_LINES.map(l => (
    <li class="rw-line" data-line={l.id}><Fragment set:html={art(l.art, l.c)} /><div><div class="nm">{l.name}</div><div class="meta">{money(l.price)} each</div></div>
      <span class="rw-step"><button type="button" data-dec={l.id} aria-label={`Decrease ${l.name}`} disabled={l.qty <= 1}>−</button><output aria-label="Quantity">{l.qty}</output><button type="button" data-inc={l.id} aria-label={`Increase ${l.name}`} disabled={l.qty >= 9}>+</button></span></li>
  ))}</ul>
  <div class="rw-prog"><p aria-live="polite">You're {money(GOAL1 - subtotal)} away from a free gift.</p>
    <div class="rw-bar"><span class="fill" style={`width:${Math.min(100, subtotal / GOAL2 * 100)}%`}></span>
      <span class="ms" style={`left:${GOAL1 / GOAL2 * 100}%`} data-tip="Free gift" data-tip-sub={`Choose one at ${money(GOAL1)}`}><svg viewBox="0 0 12 12"><path d="M2 6h8v4.5H2zM1.5 3.8h9V6h-9zM6 3.8v6.7M6 3.8C4.6 1.4 2.6 2.2 3.6 3.8M6 3.8c1.4-2.4 3.4-1.6 2.4 0" /></svg><span>{money(GOAL1)}</span></span>
      <span class="ms" style="left:100%" data-tip="Premium gift" data-tip-sub={`Unlocks at ${money(GOAL2)}`}><svg viewBox="0 0 12 12"><path d="M6 1.5l1.4 2.9 3.1.4-2.3 2.2.6 3.1L6 8.6 3.2 10.1l.6-3.1L1.5 4.8l3.1-.4z" /></svg><span>{money(GOAL2)}</span></span>
    </div>
  </div>
  <fieldset class="rw-gifts"><legend>Free gifts</legend>{GIFTS.map(g => {
    const locked = subtotal < g.min;
    return <label class="rw-gift" data-tip={locked ? `Unlocks at ${money(g.min)}` : g.name} data-tip-sub={locked ? `Add ${money(g.min - subtotal)} more` : "Free with your order"}><input type="radio" name="gwp" value={g.id} disabled={locked} /><Fragment set:html={art(g.art, g.c)} /><span class="nm">{g.name}</span><span class="pr">Worth {money(g.value)}</span><span class="lock" hidden={!locked} set:html={LOCK}></span></label>;
  })}</fieldset>
  <div class="rw-total"><div><span class="now" data-v={subtotal}>{money(subtotal)}</span></div><span class="save"></span></div>
  <button type="button" class="rw-cta">Checkout · {money(subtotal)}</button>
  <span class="rw-sr" aria-live="polite"></span>
  <span class="rw-note">Rebuilt from scratch to show how Selectable Gift with Purchase works. Not Rebuy's code.</span>
</div>
