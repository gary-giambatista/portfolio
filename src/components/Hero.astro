---
import { Image } from "astro:assets";
import portrait from "~/assets/img/gary.webp";
---
<section class="hero">
  <div class="wrap">
    <div>
      <div class="hello"><span><span class="l-en">Hoboken, NJ</span><span class="l-ja" lang="ja">ニュージャージー州ホーボーケン</span> · <span class="lang" role="group" aria-label="Language"><button type="button" data-lang="en" aria-pressed="true" lang="en">EN</button>/<button type="button" data-lang="ja" aria-pressed="false" lang="ja">日本語</button></span></span><span class="status"><i></i><span class="l-en">Open to software engineering roles</span><span class="l-ja" lang="ja">ソフトウェアエンジニア職を探しています</span></span></div>
      <h1><span class="name-ink">Gary Giambatista<canvas class="ink" data-ink="swash" data-color="--indigo" data-seed="11" data-dur="700" data-delay="900" aria-hidden="true"></canvas></span></h1>
      <span class="name-kana l-ja" lang="ja">ゲイリー・ジャンバティスタ</span>
      <p class="lede"><span class="l-en">Software engineer. I build <b>front ends people enjoy using</b>, from Shopify widgets that moved millions in sales to a kanji-writing app for iOS and Android. Scroll down to go back in time.</span><span class="l-ja" lang="ja">ソフトウェアエンジニアです。数百万ドル規模の売上を生んだShopifyのウィジェットから、iOS・Android向けの漢字書き取りアプリまで、<b>使う人が楽しめるフロントエンド</b>を作っています。下にスクロールすると、時間をさかのぼります。</span></p>
    </div>
    <figure class="portrait" tabindex="0" data-tip="Nara Park, Japan" data-tip-sub="Where the deer bow for rice crackers" data-tip-ja="奈良公園" data-tip-sub-ja="鹿せんべいを求めて鹿がお辞儀をする場所"><canvas class="ink wash" data-ink="wash" data-color="--wash" data-seed="61" aria-hidden="true"></canvas><canvas class="ink enso" data-ink="enso" data-seed="23" data-dur="1300" data-delay="250" aria-hidden="true"></canvas><Image src={portrait} alt="Gary smiling next to a deer in Nara Park, Japan" widths={[112, 176, 224, 352, 528]} sizes="(max-width: 720px) 112px, 176px" loading="eager" fetchpriority="high" /></figure>
  </div>
</section>

<div class="ruler-bar">
  <div class="wrap">
    <div class="ruler-head">
      <div class="readout" id="readout" aria-live="polite"><b>Now</b> · Kanji Kaku · Hoboken, NJ</div>
      <div class="controls">
        <div class="legend"><span><i></i><span class="l-en">Work</span><span class="l-ja" lang="ja">仕事</span></span><span><i class="sq"></i><span class="l-en">Project</span><span class="l-ja" lang="ja">個人開発</span></span><span><i class="ring"></i><span class="l-en">Learning</span><span class="l-ja" lang="ja">学び</span></span></div>
        <button class="chipbtn" type="button" data-filter="all" aria-pressed="true"><span class="l-en">All</span><span class="l-ja" lang="ja">すべて</span></button>
        <button class="chipbtn" type="button" data-filter="work" aria-pressed="false"><span class="l-en">Work</span><span class="l-ja" lang="ja">仕事</span></button>
        <button class="chipbtn" type="button" data-filter="project" aria-pressed="false"><span class="l-en">Projects</span><span class="l-ja" lang="ja">個人開発</span></button>
        <button class="chipbtn icon" type="button" id="replay" aria-label="Replay timeline intro" data-tip="Replay intro" data-tip-sub="Sweep from 2016 to now" data-tip-ja="イントロを再生" data-tip-sub-ja="2016年から現在までをたどります">↻</button>
        <span class="kbd-hint" tabindex="0" data-tip="Step through time" data-tip-sub="J for older · K for newer" data-tip-ja="時間をたどる" data-tip-sub-ja="J で過去へ · K で現在へ"><kbd>J</kbd><kbd>K</kbd></span>
      </div>
    </div>
    <div class="ruler" id="ruler" aria-label="Timeline 2016 to 2026"></div>
  </div>
</div>
