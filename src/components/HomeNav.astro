---
import { RESUME, ROUTES, SOCIAL } from "~/config/links";
import ThemeButton from "./ThemeButton.astro";
---
<header class="nav">
  <i class="nav-dye" aria-hidden="true"></i><i class="nav-dye" aria-hidden="true"></i>
  <div class="wrap">
    <nav class="socials" aria-label="Profiles">
      <a href={SOCIAL.github.href} target="_blank" rel="noopener" aria-label="GitHub" data-tip="GitHub" data-tip-sub={SOCIAL.github.handle}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
      <a href={SOCIAL.linkedin.href} target="_blank" rel="noopener" aria-label="LinkedIn" data-tip="LinkedIn" data-tip-sub={SOCIAL.linkedin.handle}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.5 0h3.83v1.57h.06c.53-1 1.84-2.07 3.79-2.07 4.05 0 4.8 2.67 4.8 6.13v5.87h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4V9.75Z"/></svg>
      </a>
      <a href={SOCIAL.instagram.href} target="_blank" rel="noopener" aria-label="Instagram" data-tip="Instagram" data-tip-sub={SOCIAL.instagram.handle}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
      </a>
      <a href={RESUME} target="_blank" rel="noopener" aria-label="Resume (PDF)" data-tip="Resume" data-tip-sub="PDF · opens in a new tab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 2.75h8l4 4V21.25H6z"/><path d="M14 2.75v4h4M9 12h6M9 15.5h6"/></svg>
      </a>
    </nav>
    <div class="links">
      <a href={ROUTES.blog} data-tip="How this site is built" data-tip-sub="Live demos of the ink, maps and more" data-tip-ja="このサイトの作り方" data-tip-sub-ja="インクや地図のライブデモ(英語)"><span class="l-en">Blog</span><span class="l-ja" lang="ja">ブログ</span></a><span class="sep">-</span><a href={ROUTES.about} data-tip="About me" data-tip-ja="自己紹介(英語)"><span class="l-en">About</span><span class="l-ja" lang="ja">自己紹介</span></a><span class="sep">-</span><a href="#contact"><span class="l-en">Contact</span><span class="l-ja" lang="ja">連絡先</span></a>
      <button class="cmdk-btn" id="cmdkBtn" type="button" aria-haspopup="dialog" data-tip="Command menu" data-tip-sub="Jump to anything" data-tip-ja="コマンドメニュー" data-tip-sub-ja="どこへでも移動"><span class="sr">Open command menu</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><kbd class="cmdk-key">⌘K</kbd></button>
      <ThemeButton tip />
    </div>
  </div>
</header>
