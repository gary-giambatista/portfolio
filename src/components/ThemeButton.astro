---
interface Props { tip?: boolean }
const { tip = false } = Astro.props;
---
<button class="theme-btn" id="themeBtn" type="button" aria-label="Toggle dark mode" {...(tip ? { "data-tip": "Switch theme", "data-tip-ja": "テーマを切り替え" } : {})}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
</button>
